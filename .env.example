# ─────────────────────────────────────────────────────────────────────────────
# BuyMeTokens — Environment Variables
#
# Copy this file and fill in real values:
#   Docker dev:  cp .env.example .env.docker
#   Native dev:  cp .env.example .env.local
#
# NEVER commit .env.docker or .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Docker dev: hostname "db" = the postgres service name in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@db:5432/buymetokens
# Native dev (without Docker): point to your local or remote Postgres instance
# DATABASE_URL=postgresql://user:password@localhost:5432/buymetokens

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-32-character-session-secret-here

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create an OAuth app at: https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get test keys from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Get webhook secret by running: stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PLATFORM_FEE_PERCENT=5

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Get your MANAGEMENT key (not a regular API key) from: https://openrouter.ai/settings/keys
OPENROUTER_MANAGEMENT_KEY=sk-or-v1-xxx

# ── Cron Security ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Vercel sets this automatically in production.
# In Docker dev, use it to manually trigger cron endpoints (see DOCKER.md).
CRON_SECRET=your-cron-secret-here

# ── Email — Phase 7, not yet active ──────────────────────────────────────────
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@buymetokens.com

# ── Rate Limiting — optional ─────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
