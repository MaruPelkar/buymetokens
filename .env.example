# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Database (Supabase or other PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/buymetokens
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-32-character-session-secret-here
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# GitHub OAuth
# Create app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Stripe
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PLATFORM_FEE_PERCENT=5

# OpenRouter
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxx

# OpenAI
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Email (Optional - for notifications using Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@buymetokens.com

# Rate Limiting (Optional - Upstash Redis)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Monitoring (Optional)
# Get from: https://sentry.io/
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Node Environment
NODE_ENV=development
